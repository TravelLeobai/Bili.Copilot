<?xml version="1.0" encoding="utf-8" ?>
<local:SearchHomePageBase
    x:Class="BiliCopilot.UI.Pages.SearchHomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:BiliCopilot.UI.Controls.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BiliCopilot.UI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--  搜索首页：背景来自 B 站装扮包，前景只有一个复用来的 AppSearchBox.  -->
    <Grid x:Name="RootGrid" Background="Transparent">

        <!--  静态背景，视频没就位时先用它  -->
        <Image
            x:Name="StaticBackground"
            Stretch="UniformToFill" />

        <!--  动态背景：装扮包里的 head_myself_mp4_bg.mp4  -->
        <MediaPlayerElement
            x:Name="VideoBackground"
            AreTransportControlsEnabled="False"
            Opacity="0"
            Stretch="UniformToFill" />

        <!--  压一层半透明，保证搜索框和文字可读  -->
        <Border x:Name="Scrim" Background="#40000000" />

        <components:AppSearchBox
            Width="560"
            Margin="0,72,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top" />
    </Grid>
</local:SearchHomePageBase>