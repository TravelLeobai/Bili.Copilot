<?xml version="1.0" encoding="utf-8" ?>
<local:SettingsPageControlBase
    x:Class="BiliCopilot.UI.Controls.Settings.TvAuthSettingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:BiliCopilot.UI.Controls.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <base:SettingsExpander
        Description="可选的补充授权：给动态转发补一个 App 鉴权用的 access_key"
        Header="转发授权（TV 扫码）">
        <base:SettingsExpander.HeaderIcon>
            <FontIcon Glyph="&#xE8D7;" />
        </base:SettingsExpander.HeaderIcon>
        <base:SettingsExpander.Items>
            <base:SettingsCard Description="{x:Bind ViewModel.TvAuthStatusText, Mode=OneWay}" Header="当前状态">
                <base:SettingsCard.HeaderIcon>
                    <ic:SymbolIcon Symbol="PersonAccounts" />
                </base:SettingsCard.HeaderIcon>
                <Button
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.AuthorizeTvCommand}"
                    Content="扫码授权" />
            </base:SettingsCard>
            <base:SettingsCard
                Description="只补一个 access_key，原登录方式不变；用于解锁动态转发中需要 App 鉴权的接口"
                Header="说明">
                <base:SettingsCard.HeaderIcon>
                    <ic:SymbolIcon Symbol="Info" />
                </base:SettingsCard.HeaderIcon>
            </base:SettingsCard>
            <base:SettingsCard Description="清掉本地保存的 access_token / refresh_token，转发会退回原来的方式" Header="清除授权">
                <base:SettingsCard.HeaderIcon>
                    <ic:SymbolIcon Symbol="Delete" />
                </base:SettingsCard.HeaderIcon>
                <Button
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.ClearTvAuthCommand}"
                    Content="清除授权" />
            </base:SettingsCard>
        </base:SettingsExpander.Items>
    </base:SettingsExpander>
</local:SettingsPageControlBase>
