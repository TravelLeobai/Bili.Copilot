<?xml version="1.0" encoding="utf-8" ?>
<local:SubscribedSeasonControlBase
    x:Class="BiliCopilot.UI.Controls.Favorites.SubscribedSeasonBody"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:local="using:BiliCopilot.UI.Controls.Favorites"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:repeater="using:Richasy.WinUIKernel.Share.Base.Repeater"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer>
            <Grid Margin="0,16,0,24">
                <repeater:AppRepeater
                    x:Name="SeasonRepeater"
                    ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                    Layout="{StaticResource VideoLayout}">
                    <repeater:AppRepeater.ItemTemplate>
                        <DataTemplate x:DataType="items:SeasonSubscriptionItemViewModel">
                            <!--  版式照着收藏夹里的视频卡片来：封面 → 作者 → 标题 → 底部一行（左期数右更新时间）  -->
                            <Grid
                                PointerReleased="OnSeasonCardPointerReleased"
                                Tapped="OnSeasonCardTapped"
                                Tag="{x:Bind}">
                                <base:CardControl AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!--  封面：左下角压一枚 UP 头像  -->
                                        <Grid>
                                            <controls:BasicCoverImage DecodeWidth="600" Source="{x:Bind CoverUri, Mode=OneWay}" />
                                            <controls:BasicCoverImage
                                                Width="24"
                                                Height="24"
                                                Margin="10"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom"
                                                CornerRadius="12"
                                                DecodeWidth="80"
                                                Source="{x:Bind AvatarUri, Mode=OneWay}" />
                                        </Grid>

                                        <Grid
                                            Grid.Row="1"
                                            Padding="16,12,16,14"
                                            RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                MaxLines="1"
                                                Text="{x:Bind AuthorName, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />

                                            <TextBlock
                                                Grid.Row="1"
                                                MaxLines="2"
                                                Text="{x:Bind Title, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />

                                            <Grid Grid.Row="2" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{x:Bind CountText, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{x:Bind UpdateText, Mode=OneWay}"
                                                    Visibility="{x:Bind UpdateText, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </base:CardControl>
                            </Grid>
                        </DataTemplate>
                    </repeater:AppRepeater.ItemTemplate>
                </repeater:AppRepeater>
            </Grid>
        </ScrollViewer>

        <base:EmptyHolder
            Description="还没有订阅任何合集"
            Emoji="&#x1F4DA;"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

        <base:LoadingWidget Text="加载中，请稍候" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
    </Grid>
</local:SubscribedSeasonControlBase>

