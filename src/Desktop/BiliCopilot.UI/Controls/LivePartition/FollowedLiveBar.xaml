<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BiliCopilot.UI.Controls.LivePartition.FollowedLiveBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:repeater="using:Richasy.WinUIKernel.Share.Base.Repeater"
    mc:Ignorable="d">

    <!--  样式对齐动态页顶部关注 UP 主条：76 高、44 圆头像、10 号名字、横向排开  -->
    <Grid Height="76" Padding="16,6,16,0">
        <ScrollViewer
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Auto"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
            <ItemsRepeater x:Name="RoomRepeater">
                <ItemsRepeater.Layout>
                    <StackLayout
                        Orientation="Horizontal"
                        Spacing="4" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="items:LiveItemViewModel">
                        <Button
                            Width="64"
                            Height="70"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind PlayCommand}"
                            CornerRadius="8"
                            ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}">
                            <Grid RowSpacing="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid
                                    Width="44"
                                    Height="44"
                                    HorizontalAlignment="Center">
                                    <controls:BasicCoverImage
                                        Width="44"
                                        Height="44"
                                        CornerRadius="22"
                                        DecodeWidth="100"
                                        Source="{x:Bind Avatar, Mode=OneWay}" />
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Fill="#FFFF4D4F" />
                                </Grid>
                                <TextBlock
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    FontSize="10"
                                    MaxLines="1"
                                    Opacity="0.7"
                                    Text="{x:Bind Author, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</UserControl>
