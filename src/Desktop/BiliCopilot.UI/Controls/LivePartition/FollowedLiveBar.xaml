<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BiliCopilot.UI.Controls.LivePartition.FollowedLiveBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:repeater="using:Richasy.WinUIKernel.Share.Base.Repeater"
    mc:Ignorable="d">

    <Grid Height="56" Padding="8,0">
        <ScrollViewer
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
            <ItemsRepeater x:Name="RoomRepeater">
                <ItemsRepeater.Layout>
                    <StackLayout
                        Orientation="Horizontal"
                        Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="items:LiveItemViewModel">
                        <Button
                            Padding="6,4"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind PlayCommand}"
                            CornerRadius="10"
                            ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Grid>
                                    <controls:BasicCoverImage
                                        Width="32"
                                        Height="32"
                                        VerticalAlignment="Center"
                                        CornerRadius="16"
                                        DecodeWidth="64"
                                        Source="{x:Bind Avatar, Mode=OneWay}" />
                                    <Border
                                        Width="8"
                                        Height="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="#FFFF4D4F"
                                        BorderBrush="White"
                                        BorderThickness="1"
                                        CornerRadius="4" />
                                </Grid>
                                <TextBlock
                                    MaxWidth="96"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Text="{x:Bind Author, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</UserControl>
