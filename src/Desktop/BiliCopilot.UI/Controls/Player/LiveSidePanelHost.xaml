<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BiliCopilot.UI.Controls.Player.LiveSidePanelHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--  外层不铺底色：只有面板本体和顶部按钮条的底色与面板一致  -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  顶部按钮条：和面板同底色、同宽，收起按钮在左，刷新在右  -->
        <Border
            Grid.Row="0"
            Width="360"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
            <Grid
                Height="44"
                Padding="8,6,8,6"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="CollapseButton"
                    Grid.Column="0"
                    Width="32"
                    Height="32"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Click="OnCollapseClick"
                    CornerRadius="8"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    ToolTipService.ToolTip="收起直播面板">
                    <ic:SymbolIcon FontSize="12" Symbol="Dismiss" />
                </Button>

                <Button
                    x:Name="RefreshButton"
                    Grid.Column="1"
                    Width="32"
                    HorizontalAlignment="Left"
                    Height="32"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Click="OnRefreshClick"
                    CornerRadius="8"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    ToolTipService.ToolTip="刷新">
                    <ic:SymbolIcon FontSize="12" Symbol="ArrowClockwise" />
                </Button>
            </Grid>
        </Border>

        <!--  面板本体  -->
        <Grid
            x:Name="PanelRoot"
            Grid.Row="1"
            Width="360"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
            <Grid x:Name="ReactorHost" />
        </Grid>

        <!--  折叠态：变成箭头贴在右侧中间  -->
        <Button
            x:Name="ExpandButton"
            Grid.RowSpan="2"
            Width="26"
            Height="64"
            Padding="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Background="{ThemeResource ControlFillColorDefaultBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            Click="OnExpandClick"
            CornerRadius="8,0,0,8"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            ToolTipService.ToolTip="展开直播面板"
            Visibility="Collapsed">
            <ic:SymbolIcon FontSize="12" Symbol="ChevronLeft" />
        </Button>
    </Grid>
</UserControl>
