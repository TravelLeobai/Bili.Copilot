<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BiliCopilot.UI.Controls.Player.LiveSidePanelHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--  外层不铺底色：按钮单独浮在视频上，只有面板本体带亚克力底  -->
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  收起按钮 + 面板：按钮在左上角，面板顶部因此多留出一条边距  -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button
                x:Name="CollapseButton"
                Height="28"
                Margin="4,10,0,0"
                Padding="10,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                Click="OnCollapseClick"
                CornerRadius="14"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                ToolTipService.ToolTip="收起直播面板">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ic:SymbolIcon FontSize="11" Symbol="ChevronRight" />
                    <TextBlock FontSize="11" Text="收起" />
                </StackPanel>
            </Button>

            <!--  折叠后的展开按钮：同样独立，不跟着面板一起上底色  -->
            <Button
                x:Name="ExpandButton"
                Height="64"
                Padding="0"
                VerticalAlignment="Center"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                Click="OnExpandClick"
                CornerRadius="10"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Visibility="Collapsed"
                Width="24">
                <ic:SymbolIcon FontSize="12" Symbol="ChevronLeft" />
            </Button>

            <Grid
                x:Name="PanelRoot"
                Grid.Row="1"
                Width="360"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
                <Grid x:Name="ReactorHost" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
