<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BiliCopilot.UI.Controls.Player.LiveSidePanelHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--  外层不再铺底色：按钮单独浮在视频上，只有面板本体带亚克力底  -->
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  收起按钮：常驻实色的小圆角块（等同悬停态），宽度只占自身，不撑满右列  -->
        <Button
            x:Name="CollapseButton"
            Grid.Column="0"
            Width="20"
            Height="64"
            Margin="0,0,4,0"
            Padding="0"
            VerticalAlignment="Center"
            Background="{ThemeResource ControlFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            Click="OnCollapseClick"
            CornerRadius="10"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            ToolTipService.ToolTip="收起直播面板">
            <ic:SymbolIcon FontSize="11" Symbol="ChevronRight" />
        </Button>

        <!--  折叠后的展开按钮：同样常驻实色，独立于面板  -->
        <Button
            x:Name="ExpandButton"
            Grid.Column="0"
            Width="24"
            Height="64"
            Padding="0"
            VerticalAlignment="Center"
            Background="{ThemeResource ControlFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            Click="OnExpandClick"
            CornerRadius="10"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            ToolTipService.ToolTip="展开直播面板"
            Visibility="Collapsed">
            <ic:SymbolIcon FontSize="12" Symbol="ChevronLeft" />
        </Button>

        <Grid
            x:Name="PanelRoot"
            Grid.Column="1"
            Width="360"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="ReactorHost" Grid.Row="0" />
        </Grid>
    </Grid>
</UserControl>
