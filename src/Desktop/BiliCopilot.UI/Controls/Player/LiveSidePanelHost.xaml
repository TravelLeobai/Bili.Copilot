<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BiliCopilot.UI.Controls.Player.LiveSidePanelHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--  外层不铺底色：按钮单独浮在视频上，只有面板本体带亚克力底  -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  收起按钮：与底栏表情/礼物同尺寸（32x32），实色底 + 叉号，放在面板左上角  -->
        <Button
            x:Name="CollapseButton"
            Grid.Row="0"
            Width="32"
            Height="32"
            Margin="8,8,0,6"
            Padding="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            Click="OnCollapseClick"
            CornerRadius="8"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            ToolTipService.ToolTip="收起直播面板">
            <ic:SymbolIcon FontSize="12" Symbol="Dismiss" />
        </Button>

        <!--  面板本体，顶部因此多出一条边距  -->
        <Grid
            x:Name="PanelRoot"
            Grid.Row="1"
            Width="360"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
            <Grid x:Name="ReactorHost" />
        </Grid>

        <!--  折叠态：变成箭头贴在右侧中间  -->
        <Button
            x:Name="ExpandButton"
            Grid.RowSpan="2"
            Width="26"
            Height="64"
            Padding="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Background="{ThemeResource ControlFillColorDefaultBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            Click="OnExpandClick"
            CornerRadius="8,0,0,8"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            ToolTipService.ToolTip="展开直播面板"
            Visibility="Collapsed">
            <ic:SymbolIcon FontSize="12" Symbol="ChevronLeft" />
        </Button>
    </Grid>
</UserControl>
