<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BiliCopilot.UI.Controls.Player.LiveSidePanelHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  折叠后的窄条  -->
        <Button
            x:Name="ExpandButton"
            Grid.Column="0"
            Width="36"
            Height="64"
            Padding="0"
            VerticalAlignment="Center"
            Click="OnExpandClick"
            ToolTipService.ToolTip="展开直播面板"
            Visibility="Collapsed">
            <ic:SymbolIcon FontSize="14" Symbol="ChevronLeft" />
        </Button>

        <Grid
            x:Name="PanelRoot"
            Grid.Column="1"
            Width="360">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="12,8,8,0">
                <Button
                    Width="32"
                    Height="28"
                    Padding="0"
                    HorizontalAlignment="Right"
                    Click="OnCollapseClick"
                    ToolTipService.ToolTip="收起直播面板">
                    <ic:SymbolIcon FontSize="12" Symbol="ChevronRight" />
                </Button>
            </Grid>
            <Grid x:Name="ReactorHost" Grid.Row="1" />
        </Grid>
    </Grid>
</UserControl>