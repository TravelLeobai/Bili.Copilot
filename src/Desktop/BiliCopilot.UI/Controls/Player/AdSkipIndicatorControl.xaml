<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BiliCopilot.UI.Controls.Player.AdSkipIndicatorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Orientation="Horizontal" Spacing="4">
        <DropDownButton
            x:Name="SponsorButton"
            Height="32"
            Padding="8,0,8,0"
            VerticalAlignment="Center"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Center"
            ToolTipService.ToolTip="空降助手：自动跳过赞助片段">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <ic:SymbolIcon
                    x:Name="SponsorIcon"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Symbol="FastForward" />
                <TextBlock x:Name="SponsorText" VerticalAlignment="Center" FontSize="12" Text="空降" />
            </StackPanel>
            <DropDownButton.Flyout>
                <MenuFlyout Placement="Bottom">
                    <ToggleMenuFlyoutItem
                        x:Name="SponsorToggleItem"
                        MinWidth="200"
                        Text="自动跳过赞助片段"
                        Click="OnSponsorToggleClick" />
                    <ToggleMenuFlyoutItem
                        x:Name="SponsorManualItem"
                        MinWidth="200"
                        Text="只提示不自动跳"
                        Click="OnSponsorManualClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="SponsorInfoItem" IsEnabled="False" Text="" />
                </MenuFlyout>
            </DropDownButton.Flyout>
        </DropDownButton>

        <DropDownButton
            x:Name="AiButton"
            Height="32"
            Padding="8,0,8,0"
            VerticalAlignment="Center"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Center"
            ToolTipService.ToolTip="AI 跳过：用大模型读字幕找广告">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <ic:SymbolIcon
                    x:Name="AiIcon"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Symbol="Sparkle" />
                <TextBlock x:Name="AiText" VerticalAlignment="Center" FontSize="12" Text="AI 跳过" />
            </StackPanel>
            <DropDownButton.Flyout>
                <MenuFlyout Placement="Bottom">
                    <ToggleMenuFlyoutItem
                        x:Name="AiToggleItem"
                        MinWidth="200"
                        Text="AI 识别广告"
                        Click="OnAiToggleClick" />
                    <ToggleMenuFlyoutItem
                        x:Name="AiAudioItem"
                        MinWidth="200"
                        Text="没有字幕时分析音频"
                        Click="OnAiAudioClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="AiInfoItem" IsEnabled="False" Text="" />
                </MenuFlyout>
            </DropDownButton.Flyout>
        </DropDownButton>
    </StackPanel>
</UserControl>
