<?xml version="1.0" encoding="utf-8" ?>
<local:VideoPlayerControlBase
    x:Class="BiliCopilot.UI.Controls.Player.VideoPlayerWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:converters="using:BiliCopilot.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BiliCopilot.UI.Controls.Player"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <local:VideoPlayerControlBase.Resources>
        <converters:TruncateTextConverter x:Key="TitleTruncateConverter" MaxLength="20" />
    </local:VideoPlayerControlBase.Resources>

    <!--  外层不加底色，鼠标悬浮时由 Button 自己那层 hover 背景露出来  -->
    <Grid RequestedTheme="Dark">
        <base:Shimmer
            MinWidth="200"
            MinHeight="72"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        <Button
            x:Name="WidgetButton"
            MinWidth="200"
            Padding="12,10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            x:Load="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource ObjectToBoolReverseConverter}}"
            Background="Transparent"
            BorderThickness="0"
            CornerRadius="12"
            Command="{x:Bind ViewModel.OpenPanelCommand, Mode=OneWay}">
            <Button.Resources>
                <!--  默认透明，只有指针进来/按下去才有底色  -->
                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1AFFFFFF" />
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2EFFFFFF" />
            </Button.Resources>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  第一行小字：UP 头像、名称、BV 号  -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
                    <controls:BasicCoverImage
                        Width="18"
                        Height="18"
                        VerticalAlignment="Center"
                        CornerRadius="9"
                        DecodeWidth="64"
                        Source="{x:Bind ViewModel.UpAvatar, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.UpAvatar, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        Text="{x:Bind ViewModel.UpName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="·" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        IsTextSelectionEnabled="False"
                        Text="{x:Bind ViewModel.BvId, Mode=OneWay}" />
                </StackPanel>

                <!--  第二行：粗体标题，20 字以内，超出补省略号  -->
                <TextBlock
                    Grid.Row="1"
                    Margin="0,6,0,0"
                    FontSize="18"
                    FontWeight="Bold"
                    MaxLines="1"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay, Converter={StaticResource TitleTruncateConverter}, ConverterParameter=20}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Button>
    </Grid>
</local:VideoPlayerControlBase>