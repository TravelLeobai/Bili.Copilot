<?xml version="1.0" encoding="utf-8" ?>
<core:PlayerControlBase
    x:Class="BiliCopilot.UI.Controls.Player.PlaybackEndPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:BiliCopilot.UI.Controls.Components"
    xmlns:core="using:BiliCopilot.UI.Controls.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:local="using:BiliCopilot.UI.Controls.Player"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:repeater="using:Richasy.WinUIKernel.Share.Base.Repeater"
    xmlns:vm="using:BiliCopilot.UI.ViewModels.Core"
    mc:Ignorable="d">

    <core:PlayerControlBase.Resources>
        <!--  UP 信息：头像 / 昵称 / 关注（已关注时显示对勾 + 已关注）  -->
        <DataTemplate x:Key="EndUpInfoTemplate" x:DataType="vm:VideoConnectorViewModel">
            <StackPanel Orientation="Horizontal" Spacing="18">
                <Border
                    Width="64"
                    Height="64"
                    Background="#33FFFFFF"
                    CornerRadius="32">
                    <Image
                        Source="{x:Bind UpAvatar, Mode=OneWay, Converter={StaticResource BitmapConverter}}"
                        Stretch="UniformToFill" />
                </Border>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="{x:Bind UpName, Mode=OneWay}" />
                <Button
                    Padding="14,6"
                    VerticalAlignment="Center"
                    Command="{x:Bind ToggleFollowCommand, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon
                            FontSize="12"
                            Symbol="Checkmark"
                            Visibility="{x:Bind IsFollow, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock
                            FontSize="13"
                            Text="已关注"
                            Visibility="{x:Bind IsFollow, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock
                            FontSize="13"
                            Text="关注"
                            Visibility="{x:Bind IsFollow, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DataTemplate>

        <!--  三个互动按钮直接绑到连接器上，收藏夹列表这类异步数据才能跟着刷新  -->
        <DataTemplate x:Key="EndOperationsTemplate" x:DataType="vm:VideoConnectorViewModel">
            <StackPanel Orientation="Horizontal" Spacing="28">
                <local:LikeButton
                    Command="{x:Bind ToggleLikeCommand, Mode=OneWay}"
                    IsLiked="{x:Bind IsLiked, Mode=OneWay}"
                    Tip="{x:Bind LikeCount, Mode=OneWay, Converter={StaticResource CountConverter}}"
                    TripleCommand="{x:Bind TripleCommand, Mode=OneWay}" />
                <local:CoinButton
                    AlsoLike="{x:Bind IsCoinAlsoLike, Mode=TwoWay}"
                    Command="{x:Bind CoinCommand, Mode=OneWay}"
                    IsCoined="{x:Bind IsCoined, Mode=OneWay}"
                    Tip="{x:Bind CoinCount, Mode=OneWay, Converter={StaticResource CountConverter}}" />
                <local:FavoriteButton
                    Command="{x:Bind FavoriteCommand, Mode=OneWay}"
                    InitializeCommand="{x:Bind InitializeFavoritesCommand, Mode=OneWay}"
                    IsFavorited="{x:Bind IsFavorited, Mode=OneWay}"
                    ItemsSource="{x:Bind FavoriteFolders, Mode=OneWay}"
                    Tip="{x:Bind FavoriteCount, Mode=OneWay, Converter={StaticResource CountConverter}}" />
            </StackPanel>
        </DataTemplate>
    </core:PlayerControlBase.Resources>

    <!--  播放结束页：暗色遮罩 + 一行（UP 信息 + 互动按钮）+ 相关推荐  -->
    <Grid Background="#E6101010" RequestedTheme="Dark">
        <ScrollViewer
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid Padding="48,32,48,40">
                <StackPanel
                    MaxWidth="1100"
                    HorizontalAlignment="Center"
                    Spacing="30">

                    <!--  同一行：左边 UP 信息与关注，右边重播 / 互动 / 分享；窗口窄了才换行  -->
                    <Grid
                        x:Name="EndHeader"
                        ColumnSpacing="24"
                        RowSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ContentControl
                            x:Name="EndUpInfo"
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Center"
                            Content="{x:Bind ViewModel.EndConnector, Mode=OneWay}"
                            ContentTemplate="{StaticResource EndUpInfoTemplate}"
                            IsTabStop="False" />

                        <StackPanel
                            x:Name="EndActions"
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="28">
                            <StackPanel Spacing="8">
                                <Button
                                    Width="48"
                                    Height="48"
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    Command="{x:Bind ViewModel.ReplayFromEndCommand, Mode=OneWay}"
                                    CornerRadius="24"
                                    ToolTipService.ToolTip="重播">
                                    <ic:SymbolIcon FontSize="16" Symbol="ArrowSync" />
                                </Button>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Opacity="0.8"
                                    Text="重播" />
                            </StackPanel>

                            <ContentControl
                                HorizontalContentAlignment="Left"
                                VerticalContentAlignment="Center"
                                Content="{x:Bind ViewModel.EndConnector, Mode=OneWay}"
                                ContentTemplate="{StaticResource EndOperationsTemplate}"
                                IsTabStop="False" />

                            <StackPanel Spacing="8">
                                <Button
                                    Width="48"
                                    Height="48"
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    Command="{x:Bind ViewModel.EndShareCommand, Mode=OneWay}"
                                    CornerRadius="24"
                                    ToolTipService.ToolTip="分享">
                                    <ic:SymbolIcon FontSize="16" Symbol="Share" />
                                </Button>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Opacity="0.8"
                                    Text="分享" />
                            </StackPanel>
                        </StackPanel>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <!--  宽：UP 信息与按钮同一行，按钮靠右  -->
                                <VisualState x:Name="WideHeaderState">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="1100" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <!--  窄：按钮换到第二行，靠左  -->
                                <VisualState x:Name="NarrowHeaderState">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="0" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="EndActions.(Grid.Row)" Value="1" />
                                        <Setter Target="EndActions.(Grid.Column)" Value="0" />
                                        <Setter Target="EndActions.(Grid.ColumnSpan)" Value="2" />
                                        <Setter Target="EndActions.HorizontalAlignment" Value="Left" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>

                    <!--  相关推荐：最多三列，随窗口宽度在 1~3 列之间变化  -->
                    <StackPanel Spacing="14">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="接着看" />
                        <repeater:AppRepeater ItemsSource="{x:Bind ViewModel.EndRecommendations, Mode=OneWay}">
                            <repeater:AppRepeater.ItemTemplate>
                                <DataTemplate x:DataType="items:VideoItemViewModel">
                                    <components:VideoCardControl Style="{StaticResource PlayerRecommendVideoCardStyle}" ViewModel="{x:Bind}" />
                                </DataTemplate>
                            </repeater:AppRepeater.ItemTemplate>
                            <repeater:AppRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="Fill"
                                    MaximumRowsOrColumns="3"
                                    MinColumnSpacing="16"
                                    MinItemWidth="300"
                                    MinRowSpacing="16"
                                    Orientation="Horizontal" />
                            </repeater:AppRepeater.Layout>
                        </repeater:AppRepeater>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!--  底部只留一根不可拖动的进度条  -->
        <ProgressBar
            Height="3"
            VerticalAlignment="Bottom"
            Background="#33FFFFFF"
            Foreground="#FFFFFFFF"
            IsHitTestVisible="False"
            Maximum="{x:Bind ViewModel.Player.Duration, Mode=OneWay}"
            Value="{x:Bind ViewModel.Player.Position, Mode=OneWay}" />
    </Grid>
</core:PlayerControlBase>
