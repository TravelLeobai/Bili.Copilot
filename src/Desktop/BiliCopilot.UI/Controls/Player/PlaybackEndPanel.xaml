<?xml version="1.0" encoding="utf-8" ?>
<core:PlayerControlBase
    x:Class="BiliCopilot.UI.Controls.Player.PlaybackEndPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:BiliCopilot.UI.Controls.Components"
    xmlns:core="using:BiliCopilot.UI.Controls.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:local="using:BiliCopilot.UI.Controls.Player"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:repeater="using:Richasy.WinUIKernel.Share.Base.Repeater"
    mc:Ignorable="d">

    <!--  播放结束页：暗色遮罩 + UP 信息 + 重播与互动 + 相关推荐  -->
    <Grid Background="#E6101010" RequestedTheme="Dark">
        <ScrollViewer
            HorizontalContentAlignment="Center"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                Width="1100"
                Margin="0,32,0,40"
                HorizontalAlignment="Center"
                Spacing="30">

                <!--  UP 信息 / 关注 / 充电  -->
                <StackPanel Orientation="Horizontal" Spacing="18">
                    <Border
                        Width="64"
                        Height="64"
                        Background="#33FFFFFF"
                        CornerRadius="32">
                        <Image
                            Source="{x:Bind ViewModel.EndUpAvatar, Mode=OneWay, Converter={StaticResource BitmapConverter}}"
                            Stretch="UniformToFill" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.EndUpName, Mode=OneWay}" />
                    <Button
                        Padding="14,6"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.EndFollowCommand, Mode=OneWay}">
                        <TextBlock FontSize="13" Text="关注" />
                    </Button>
                    <Button
                        Padding="16,6"
                        VerticalAlignment="Center"
                        BorderBrush="#66FFFFFF"
                        Command="{x:Bind ViewModel.EndOpenUserSpaceCommand, Mode=OneWay}">
                        <TextBlock FontSize="13" Text="充电" />
                    </Button>
                </StackPanel>

                <!--  重播 + 互动  -->
                <StackPanel
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="40">
                    <Button
                        Padding="20,8"
                        Background="Transparent"
                        BorderBrush="#55FFFFFF"
                        Command="{x:Bind ViewModel.ReplayFromEndCommand, Mode=OneWay}">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="重播" />
                    </Button>
                    <Rectangle
                        Width="1"
                        Height="34"
                        VerticalAlignment="Center"
                        Fill="#33FFFFFF" />
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.EndLikeCommand, Mode=OneWay}">
                        <StackPanel Spacing="2">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="13"
                                Text="好评" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Opacity="0.75"
                                Text="{x:Bind ViewModel.EndLikeText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.CoinFromEndCommand, Mode=OneWay}">
                        <StackPanel Spacing="2">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="13"
                                Text="投币" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Opacity="0.75"
                                Text="{x:Bind ViewModel.EndCoinText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.EndFavoriteCommand, Mode=OneWay}">
                        <StackPanel Spacing="2">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="13"
                                Text="收藏" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Opacity="0.75"
                                Text="{x:Bind ViewModel.EndFavoriteText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.EndShareCommand, Mode=OneWay}">
                        <StackPanel Spacing="2">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="13"
                                Text="分享" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Opacity="0.75"
                                Text=" " />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  相关推荐：沿用播放器推荐分区那套现成卡片  -->
                <StackPanel Spacing="14">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="接着看" />
                    <repeater:AppRepeater ItemsSource="{x:Bind ViewModel.EndRecommendations, Mode=OneWay}">
                        <repeater:AppRepeater.ItemTemplate>
                            <DataTemplate x:DataType="items:VideoItemViewModel">
                                <components:VideoCardControl Style="{StaticResource PlayerRecommendVideoCardStyle}" ViewModel="{x:Bind}" />
                            </DataTemplate>
                        </repeater:AppRepeater.ItemTemplate>
                        <repeater:AppRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MinColumnSpacing="12"
                                MinItemWidth="230"
                                MinRowSpacing="12" />
                        </repeater:AppRepeater.Layout>
                    </repeater:AppRepeater>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--  底部只留一根不可拖动的进度条  -->
        <ProgressBar
            Height="3"
            VerticalAlignment="Bottom"
            Background="#33FFFFFF"
            Foreground="#FFFFFFFF"
            IsHitTestVisible="False"
            Maximum="{x:Bind ViewModel.Player.Duration, Mode=OneWay}"
            Value="{x:Bind ViewModel.Player.Position, Mode=OneWay}" />
    </Grid>
</core:PlayerControlBase>
