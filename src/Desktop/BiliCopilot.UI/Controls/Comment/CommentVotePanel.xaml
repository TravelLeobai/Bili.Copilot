<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BiliCopilot.UI.Controls.Comment.CommentVotePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsTabStop="False"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  行高/内边距照搬互动弹幕投票卡片里的选项行，两处看起来是一套东西。  -->
        <Style
            x:Key="VoteChoiceStyle"
            BasedOn="{StaticResource DefaultToggleButtonStyle}"
            TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="11,5,11,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <!--  焦点框画在行内：贴边的列表会把它裁掉一半。  -->
            <Setter Property="FocusVisualMargin" Value="0" />
        </Style>
        <Style
            x:Key="VoteCaptionStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <!--
        评论附带的投票。宽度由宿主给（入口弹出里是 340）。
        选项一多就让中间的列表自己滚，标题和下面的按钮始终留在视野里。
    -->
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <ic:SymbolIcon
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Symbol="Poll" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource VoteCaptionStyle}"
                    Text="投票" />
            </StackPanel>
            <TextBlock
                MaxLines="6"
                AutomationProperties.HeadingLevel="Level2"
                IsTabStop="False"
                IsTextSelectionEnabled="True"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
            <TextBlock
                MaxLines="6"
                IsTabStop="False"
                IsTextSelectionEnabled="True"
                Style="{StaticResource VoteCaptionStyle}"
                Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasDescription, Mode=OneWay}" />
            <TextBlock
                Style="{StaticResource VoteCaptionStyle}"
                Text="{x:Bind ViewModel.Meta, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasMeta, Mode=OneWay}" />
        </StackPanel>

        <!--  正在加载。  -->
        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <ProgressRing
                Width="16"
                Height="16"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource VoteCaptionStyle}"
                Text="正在加载投票…" />
        </StackPanel>

        <!--  加载失败：说清楚，并且给一个重试。  -->
        <StackPanel
            Grid.Row="1"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsFailed, Mode=OneWay}">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ic:SymbolIcon
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    IconVariant="Filled"
                    Symbol="Warning" />
                <TextBlock
                    x:Name="FailedBlock"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Text="投票没有加载出来"
                    TextWrapping="Wrap" />
            </Grid>
            <Button
                MinWidth="96"
                Command="{x:Bind ViewModel.LoadCommand, Mode=OneWay}"
                Content="重试" />
        </StackPanel>

        <!--  投票被删掉了，或者不给看。  -->
        <TextBlock
            x:Name="UnavailableBlock"
            Grid.Row="1"
            AutomationProperties.LiveSetting="Polite"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="这个投票已被删除，或者暂时无法查看"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay}" />

        <!--
            选项。能投的时候每一行是可勾选的（单选是圆点、多选是方框）；
            投过之后、或者本来就不能投，同一行改成显示票数、占比和自己选的那一项。
        -->
        <ScrollViewer
            x:Name="OptionsScroller"
            Grid.Row="1"
            MaxHeight="364"
            AutomationProperties.Name="投票选项"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            IsTabStop="False"
            UseSystemFocusVisuals="True"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}">
            <ItemsControl
                IsTabStop="False"
                ItemsSource="{x:Bind ViewModel.Options, Mode=OneWay}"
                XYFocusKeyboardNavigation="Enabled">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="items:CommentVoteOptionViewModel">
                        <Grid Margin="0,0,0,6">
                            <ToggleButton
                                AutomationProperties.Name="{x:Bind Text}"
                                Click="OnOptionClick"
                                IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                                IsEnabled="{x:Bind CanChoose, Mode=OneWay}"
                                Style="{StaticResource VoteChoiceStyle}"
                                Tag="{x:Bind}"
                                Visibility="{x:Bind IsChoice, Mode=OneWay}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ic:SymbolIcon
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        IconVariant="{x:Bind GlyphVariant, Mode=OneWay}"
                                        Symbol="{x:Bind Glyph, Mode=OneWay}" />
                                    <controls:BasicCoverImage
                                        Grid.Column="1"
                                        Width="44"
                                        Height="44"
                                        Margin="0,2"
                                        VerticalAlignment="Center"
                                        CornerRadius="{StaticResource ControlCornerRadius}"
                                        DecodeWidth="88"
                                        Source="{x:Bind Image}"
                                        Visibility="{x:Bind HasImage}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        MaxLines="3"
                                        Text="{x:Bind Text}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </ToggleButton>
                            <Grid
                                MinHeight="36"
                                Padding="11,3,11,4"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                ColumnSpacing="6"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                RowSpacing="3"
                                Visibility="{x:Bind IsResult, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <controls:BasicCoverImage
                                    Width="44"
                                    Height="44"
                                    Margin="0,3,2,1"
                                    VerticalAlignment="Center"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    DecodeWidth="88"
                                    Source="{x:Bind Image}"
                                    Visibility="{x:Bind HasImage}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw"
                                    MaxLines="3"
                                    Text="{x:Bind Text}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <ic:SymbolIcon
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    IconVariant="Filled"
                                    Symbol="CheckmarkCircle"
                                    ToolTipService.ToolTip="你选的"
                                    Visibility="{x:Bind IsMine, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Style="{StaticResource VoteCaptionStyle}"
                                    Text="{x:Bind Stats, Mode=OneWay}" />
                                <ProgressBar
                                    Grid.Row="1"
                                    Grid.ColumnSpan="4"
                                    AutomationProperties.Name="{x:Bind ResultName, Mode=OneWay}"
                                    Maximum="100"
                                    Value="{x:Bind Percent, Mode=OneWay}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}">
            <!--  一行话：还能选几项、正在提交、哪里失败了，或者为什么不能投。  -->
            <Grid ColumnSpacing="6" Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ic:SymbolIcon
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    IconVariant="Filled"
                    Symbol="Warning"
                    Visibility="{x:Bind ViewModel.IsStatusFailure, Mode=OneWay}" />
                <TextBlock
                    x:Name="StatusBlock"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource VoteCaptionStyle}"
                    Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Grid>
            <Grid
                x:Name="SubmitRow"
                ColumnSpacing="12"
                Visibility="{x:Bind ViewModel.IsChoosing, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    MinWidth="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="匿名投票"
                    Content="匿名投票"
                    IsChecked="{x:Bind ViewModel.IsAnonymous, Mode=TwoWay}" />
                <Button
                    x:Name="SubmitButton"
                    Grid.Column="1"
                    MinWidth="96"
                    VerticalAlignment="Center"
                    Click="OnSubmitClick"
                    Command="{x:Bind ViewModel.SubmitCommand, Mode=OneWay}"
                    Content="投票"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
