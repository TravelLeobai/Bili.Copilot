<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BiliCopilot.UI.Controls.Moment.LiveUperBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items">

    <ScrollViewer
        Padding="16,6,16,0"
        HorizontalScrollBarVisibility="Hidden"
        HorizontalScrollMode="Auto"
        VerticalScrollBarVisibility="Disabled"
        VerticalScrollMode="Disabled">
        <ItemsView
            x:Name="UperView"
            SelectionMode="Single">
            <ItemsView.ItemTemplate>
                <DataTemplate x:DataType="items:LiveSectionUperViewModel">
                    <ItemContainer
                        Width="64"
                        Height="70"
                        Padding="0"
                        Background="Transparent"
                        Style="{StaticResource AppItemContainerStyle}"
                        ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}">
                        <Grid RowSpacing="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid
                                Width="44"
                                Height="44"
                                HorizontalAlignment="Center">
                                <ic:SymbolIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    Symbol="BubbleMultiple"
                                    Visibility="{x:Bind IsTotal, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <controls:BasicCoverImage
                                    Width="44"
                                    Height="44"
                                    CornerRadius="22"
                                    DecodeWidth="100"
                                    Source="{x:Bind Avatar, Mode=OneWay}"
                                    Visibility="{x:Bind IsTotal, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
                            </Grid>
                            <TextBlock
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                FontSize="10"
                                MaxLines="1"
                                Opacity="0.7"
                                Text="{x:Bind Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </ItemContainer>
                </DataTemplate>
            </ItemsView.ItemTemplate>
            <ItemsView.Layout>
                <StackLayout Orientation="Horizontal" Spacing="4" />
            </ItemsView.Layout>
        </ItemsView>
    </ScrollViewer>
</UserControl>
