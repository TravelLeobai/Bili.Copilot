<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BiliCopilot.UI.Controls.Moment.LiveCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:ic="using:FluentIcons.WinUI">

    <Grid
        MinHeight="240"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        CornerRadius="8"
        Tapped="OnCardTapped">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="126" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  作者行：头像 + 名字 + 右侧角标  -->
        <Grid
            Margin="12,10,12,6"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:BasicCoverImage
                Width="32"
                Height="32"
                CornerRadius="16"
                DecodeWidth="100"
                Source="{x:Bind ViewModel.Avatar, Mode=OneWay}" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="13"
                MaxLines="1"
                Text="{x:Bind ViewModel.AuthorName, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <Border
                Grid.Column="2"
                Padding="6,1"
                VerticalAlignment="Center"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="4">
                <TextBlock
                    FontSize="10"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Text="{x:Bind ViewModel.Badge, Mode=OneWay}" />
            </Border>
        </Grid>

        <!--  封面  -->
        <Grid Grid.Row="1">
            <controls:BasicCoverImage DecodeWidth="600" Source="{x:Bind ViewModel.CoverUri, Mode=OneWay}" />
        </Grid>

        <!--  标题：最多两行；卡片高度由内容决定，不会因为标题行数变化被裁  -->
        <TextBlock
            Grid.Row="2"
            Margin="12,8,12,4"
            FontSize="13"
            MaxLines="2"
            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="Wrap" />

        <!--  底部：只保留用浏览器打开  -->
        <Grid
            Grid.Row="3"
            Margin="12,0,8,8"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="11"
                Opacity="0.6"
                Text="{x:Bind ViewModel.Detail, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <Button
                Grid.Column="1"
                Padding="6"
                AutomationProperties.Name="在浏览器中打开"
                Click="OnOpenInBrowserClick"
                Style="{StaticResource BasicPlayerIconButtonStyle}"
                ToolTipService.ToolTip="在浏览器中打开">
                <ic:SymbolIcon FontSize="14" Symbol="Globe" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
