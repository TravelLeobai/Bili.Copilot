<?xml version="1.0" encoding="utf-8" ?>
<local:LiveSectionControlBase
    x:Class="BiliCopilot.UI.Controls.Moment.LiveMomentSectionDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:local="using:BiliCopilot.UI.Controls.Moment"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  顶部 UP 主过滤栏：和动态页视频/综合分区同一套条形样式  -->
        <ScrollViewer
            Grid.Row="0"
            Height="76"
            Padding="16,6,16,0"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Auto"
            VerticalAlignment="Top"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Upers, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="items:LiveSectionUperViewModel">
                        <Button
                            Padding="8,4"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind SelectCommand}"
                            ToolTipService.ToolTip="{x:Bind Name}">
                            <StackPanel Width="56" Spacing="4">
                                <Grid>
                                    <ic:SymbolIcon
                                        Margin="6,0"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Symbol="BubbleMultiple"
                                        Visibility="{x:Bind IsTotal, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <controls:BasicCoverImage
                                        Width="40"
                                        Height="40"
                                        VerticalAlignment="Center"
                                        CornerRadius="20"
                                        DecodeWidth="100"
                                        Source="{x:Bind Avatar, Mode=OneWay}"
                                        Visibility="{x:Bind IsTotal, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
                                </Grid>
                                <TextBlock
                                    FontSize="11"
                                    MaxLines="1"
                                    Text="{x:Bind Name, Mode=OneWay}"
                                    TextAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!--  卡片：沿用动态里视频卡片的排版（头像+作者 / 封面 / 标题 / 底部操作），
              直播卡去掉点赞和展开全文，只留"用浏览器打开"  -->
        <ScrollViewer
            Grid.Row="1"
            Padding="16,4,16,16"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <!--  按窗口宽度自动增减列数，卡片宽度均分  -->
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="16"
                        MinItemHeight="250"
                        MinItemWidth="240"
                        MinRowSpacing="16" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="items:LiveSectionCardViewModel">
                    <Grid
                        MinHeight="240"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        Tapped="OnCardTapped">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="126" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!--  作者行  -->
                        <Grid
                            Margin="12,10,12,6"
                            ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:BasicCoverImage
                                Width="32"
                                Height="32"
                                CornerRadius="16"
                                DecodeWidth="100"
                                Source="{x:Bind Avatar, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="13"
                                MaxLines="1"
                                Text="{x:Bind AuthorName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <!--  封面 + 角标  -->
                        <Grid Grid.Row="1">
                            <controls:BasicCoverImage
                                DecodeWidth="600"
                                Source="{x:Bind CoverUri, Mode=OneWay}" />
                            <Border
                                Padding="6,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="#CC000000"
                                CornerRadius="4">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="White"
                                    Text="{x:Bind Badge, Mode=OneWay}" />
                            </Border>
                        </Grid>

                        <TextBlock
                            Grid.Row="2"
                            Margin="12,8,12,4"
                            FontSize="13"
                            MaxLines="2"
                            Text="{x:Bind Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />

                        <!--  底部：只保留用浏览器打开  -->
                        <Grid
                            Grid.Row="3"
                            Margin="12,0,8,8"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                Opacity="0.6"
                                Text="{x:Bind Detail, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                Grid.Column="1"
                                Padding="6"
                                AutomationProperties.Name="在浏览器中打开"
                                Click="OnOpenInBrowserClick"
                                Style="{StaticResource BasicPlayerIconButtonStyle}"
                                ToolTipService.ToolTip="在浏览器中打开">
                                <ic:SymbolIcon FontSize="14" Symbol="Globe" />
                            </Button>
                        </Grid>
                    </Grid>
                </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</local:LiveSectionControlBase>





