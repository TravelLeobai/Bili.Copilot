<?xml version="1.0" encoding="utf-8" ?>
<local:LiveSectionControlBase
    x:Class="BiliCopilot.UI.Controls.Moment.LiveMomentSectionDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:local="using:BiliCopilot.UI.Controls.Moment"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--  卡片模板放在控件资源里：代码建列时要用 Resources["LiveCardTemplate"] 取它，
          放在内层 Grid.Resources 会取不到（之前卡片整片空白就是这个原因）  -->
    <local:LiveSectionControlBase.Resources>
        <DataTemplate x:Key="LiveCardTemplate" x:DataType="items:LiveSectionCardViewModel">
            <!--  CardControl 是内核里统一的卡片壳：背景、描边、圆角、悬停背景都由它提供，
                  动态里的视频卡片（FullMomentCardStyle / VideoMomentCardStyle / RecommendVideoCardStyle）
                  全都套这一层，直播卡也照这个来，样式才和它们对齐  -->
            <base:CardControl
                MinHeight="240"
                AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                PointerEntered="OnCardPointerEntered"
                PointerExited="OnCardPointerExited">
                <Grid
                    MinHeight="240"
                    PointerReleased="OnCardPointerReleased"
                    Tapped="OnCardTapped"
                    Tag="{x:Bind}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="126" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  作者行：头像 + 名字 + 右侧角标（右边距 12，和头像左边距一致）  -->
                    <Grid
                        Margin="12,10,12,6"
                        ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:BasicCoverImage
                            Width="32"
                            Height="32"
                            CornerRadius="16"
                            DecodeWidth="100"
                            Source="{x:Bind Avatar, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="13"
                            MaxLines="1"
                            Text="{x:Bind AuthorName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <!--  直播中：实心 accent；回放/切片：outline  -->
                        <Border
                            Grid.Column="2"
                            Padding="6,1"
                            VerticalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="4"
                            Visibility="{x:Bind IsLive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock
                                FontSize="10"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Text="{x:Bind Badge, Mode=OneWay}" />
                        </Border>
                        <Border
                            Grid.Column="2"
                            Padding="5,0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="{x:Bind IsLive, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}">
                            <TextBlock
                                FontSize="10"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Text="{x:Bind Badge, Mode=OneWay}" />
                        </Border>
                    </Grid>

                    <!--  封面  -->
                    <Grid Grid.Row="1">
                        <controls:BasicCoverImage DecodeWidth="600" Source="{x:Bind CoverUri, Mode=OneWay}" />
                    </Grid>

                    <TextBlock
                        Grid.Row="2"
                        Margin="12,8,12,4"
                        FontSize="13"
                        MaxLines="{x:Bind TitleMaxLines, Mode=OneWay}"
                        Text="{x:Bind Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />

                    <!--  底部：只保留用浏览器打开  -->
                    <Grid
                        Grid.Row="3"
                        Margin="12,0,8,8"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Opacity="0.6"
                            Text="{x:Bind Detail, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <!--  不用播放器那套固定深色样式：改走系统主题色，深浅色下都跟着变  -->
                        <Button
                            Grid.Column="1"
                            Padding="6"
                            AutomationProperties.Name="在浏览器中打开"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnOpenInBrowserClick"
                            CornerRadius="6"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            ToolTipService.ToolTip="在浏览器中打开">
                            <ic:SymbolIcon FontSize="14" Symbol="Globe" />
                        </Button>
                    </Grid>
                </Grid>
            </base:CardControl>
        </DataTemplate>
    </local:LiveSectionControlBase.Resources>

    <Grid HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  顶部 UP 主过滤栏：与视频/综合分区同一套  -->
        <ScrollViewer
            Grid.Row="0"
            Height="76"
            Padding="16,6,16,0"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Auto"
            VerticalAlignment="Top"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
            <ItemsView
                x:Name="UperView"
                ItemsSource="{x:Bind ViewModel.Upers, Mode=OneWay}"
                SelectionMode="Single"
                SelectionChanged="OnUperSelectionChanged">
                <ItemsView.ItemTemplate>
                    <DataTemplate x:DataType="items:LiveSectionUperViewModel">
                        <ItemContainer
                            Width="64"
                            Height="70"
                            Padding="0"
                            Background="Transparent"
                            Style="{StaticResource AppItemContainerStyle}"
                            ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}">
                            <Grid RowSpacing="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid
                                    Width="44"
                                    Height="44"
                                    HorizontalAlignment="Center">
                                    <ic:SymbolIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        Symbol="BubbleMultiple"
                                        Visibility="{x:Bind IsTotal, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <controls:BasicCoverImage
                                        Width="44"
                                        Height="44"
                                        CornerRadius="22"
                                        DecodeWidth="100"
                                        Source="{x:Bind Avatar, Mode=OneWay}"
                                        Visibility="{x:Bind IsTotal, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
                                </Grid>
                                <TextBlock
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    FontSize="10"
                                    MaxLines="1"
                                    Opacity="0.7"
                                    Text="{x:Bind Name, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </ItemContainer>
                    </DataTemplate>
                </ItemsView.ItemTemplate>
                <ItemsView.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="4" />
                </ItemsView.Layout>
            </ItemsView>
        </ScrollViewer>

        <!--  卡片区：声明式 ItemsRepeater + UniformGridLayout。
              ItemsStretch=None：卡片按内容自然高度，行高由该行最高的卡片决定（互不拉伸）；
              MinItemWidth 在代码里按可用宽度动态算，所以列宽仍然均分、右侧不留空白  -->
        <ScrollViewer
            x:Name="CardScroller"
            Grid.Row="1"
            Padding="16,12,16,16"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        x:Name="CardLayout"
                        ItemsStretch="None"
                        MinColumnSpacing="16"
                        MinItemWidth="240"
                        MinRowSpacing="16" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <StaticResource ResourceKey="LiveCardTemplate" />
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</local:LiveSectionControlBase>





