<?xml version="1.0" encoding="utf-8" ?>
<local:LiveSectionControlBase
    x:Class="BiliCopilot.UI.Controls.Moment.LiveMomentSectionDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:local="using:BiliCopilot.UI.Controls.Moment"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  顶部 UP 主过滤栏  -->
        <ScrollViewer
            Grid.Row="0"
            Padding="16,10,16,8"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Auto"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Upers, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="12" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="items:LiveSectionUperViewModel">
                        <Button
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind SelectCommand}"
                            ToolTipService.ToolTip="{x:Bind Name}">
                            <Border
                                Padding="12,6"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                CornerRadius="14">
                                <TextBlock
                                    FontSize="12"
                                    MaxLines="1"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis" />
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!--  直播 + 回放卡片  -->
        <GridView
            Grid.Row="1"
            Padding="16,0,16,16"
            IsItemClickEnabled="True"
            ItemClick="OnCardClick"
            ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
            SelectionMode="None">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid ItemHeight="212" ItemWidth="248" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="items:LiveSectionCardViewModel">
                    <Grid
                        Width="232"
                        Height="204"
                        Padding="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="126" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Image
                                Source="{x:Bind Cover, Converter={StaticResource BitmapConverter}}"
                                Stretch="UniformToFill" />
                            <Border
                                Padding="6,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="#CC000000"
                                CornerRadius="4">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="White"
                                    Text="{x:Bind Badge}" />
                            </Border>
                        </Grid>
                        <StackPanel
                            Grid.Row="1"
                            Margin="10,8,10,8"
                            Spacing="4">
                            <TextBlock
                                FontSize="13"
                                MaxLines="2"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="11"
                                Opacity="0.75"
                                Text="{x:Bind AuthorName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="11"
                                Opacity="0.6"
                                Text="{x:Bind Detail}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</local:LiveSectionControlBase>

