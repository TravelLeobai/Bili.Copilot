<?xml version="1.0" encoding="utf-8" ?>
<local:LiveSectionControlBase
    x:Class="BiliCopilot.UI.Controls.Moment.LiveMomentSectionDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:local="using:BiliCopilot.UI.Controls.Moment"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  顶部 UP 主过滤栏：与视频/综合分区同一套（ItemsView + ItemContainer 64×70、间距 4）  -->
        <ScrollViewer
            Grid.Row="0"
            Height="76"
            Padding="16,6,16,0"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Auto"
            VerticalAlignment="Top"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
            <ItemsView
                x:Name="UperView"
                ItemsSource="{x:Bind ViewModel.Upers, Mode=OneWay}"
                SelectionMode="Single">
                <ItemsView.ItemTemplate>
                    <DataTemplate x:DataType="items:LiveSectionUperViewModel">
                        <ItemContainer
                            Width="64"
                            Height="70"
                            Padding="0"
                            Background="Transparent"
                            Style="{StaticResource AppItemContainerStyle}"
                            ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}">
                            <Grid RowSpacing="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid
                                    Width="44"
                                    Height="44"
                                    HorizontalAlignment="Center">
                                    <ic:SymbolIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        Symbol="BubbleMultiple"
                                        Visibility="{x:Bind IsTotal, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <controls:BasicCoverImage
                                        Width="44"
                                        Height="44"
                                        CornerRadius="22"
                                        DecodeWidth="100"
                                        Source="{x:Bind Avatar, Mode=OneWay}"
                                        Visibility="{x:Bind IsTotal, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
                                </Grid>
                                <TextBlock
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    FontSize="10"
                                    MaxLines="1"
                                    Opacity="0.7"
                                    Text="{x:Bind Name, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </ItemContainer>
                    </DataTemplate>
                </ItemsView.ItemTemplate>
                <ItemsView.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="4" />
                </ItemsView.Layout>
            </ItemsView>
        </ScrollViewer>

        <!--  卡片区：GridView + ItemsWrapGrid，卡片宽度按窗口宽度均分（列数自动增减）  -->
        <GridView
            x:Name="CardView"
            Grid.Row="1"
            Padding="16,4,16,0"
            IsItemClickEnabled="True"
            ItemClick="OnCardClick"
            ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
            SelectionMode="None"
            SizeChanged="OnCardViewSizeChanged">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="0,0,16,16" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid x:Name="CardPanel" ItemHeight="250" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="items:LiveSectionCardViewModel">
                    <Grid
                        MinHeight="240"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        Tapped="OnCardTapped">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="126" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  作者行：头像 + 名字 + 右侧角标（右边距 12，和头像左边距一致）  -->
                        <Grid
                            Margin="12,10,12,6"
                            ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:BasicCoverImage
                                Width="32"
                                Height="32"
                                CornerRadius="16"
                                DecodeWidth="100"
                                Source="{x:Bind Avatar, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="13"
                                MaxLines="1"
                                Text="{x:Bind AuthorName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <Border
                                Grid.Column="2"
                                Padding="6,1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="4">
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Text="{x:Bind Badge, Mode=OneWay}" />
                            </Border>
                        </Grid>

                        <!--  封面  -->
                        <Grid Grid.Row="1">
                            <controls:BasicCoverImage DecodeWidth="600" Source="{x:Bind CoverUri, Mode=OneWay}" />
                        </Grid>

                        <TextBlock
                            Grid.Row="2"
                            Margin="12,8,12,4"
                            FontSize="13"
                            MaxLines="2"
                            Text="{x:Bind Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />

                        <!--  底部：只保留用浏览器打开  -->
                        <Grid
                            Grid.Row="3"
                            Margin="12,0,8,8"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                Opacity="0.6"
                                Text="{x:Bind Detail, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                Grid.Column="1"
                                Padding="6"
                                AutomationProperties.Name="在浏览器中打开"
                                Click="OnOpenInBrowserClick"
                                Style="{StaticResource BasicPlayerIconButtonStyle}"
                                ToolTipService.ToolTip="在浏览器中打开">
                                <ic:SymbolIcon FontSize="14" Symbol="Globe" />
                            </Button>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</local:LiveSectionControlBase>
