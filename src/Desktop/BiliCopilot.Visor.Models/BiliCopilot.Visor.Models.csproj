<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<RootNamespace>BiliCopilot.Visor.Models</RootNamespace>
	<AssemblyName>BiliCopilot.Visor.Models</AssemblyName>
    <!--
      Runtime Async（.NET 11 预览特性）：与 Visor / UI 两个可执行工程保持一致。
      本工程当前没有 async 方法，所以这个开关眼下是零收益；补它是为了以后有人往 Models
      里写 async 时不会悄悄退回状态机形态（t2 审计 §12-7）。

      注意：MSBuild 不把 Features 当重编译输入，改完必须 -t:Rebuild，否则编出来的还是老形态。
    -->
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

</Project>

